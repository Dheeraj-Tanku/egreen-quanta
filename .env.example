# ============================================================================
# Egreen Quanta — environment configuration
# Copy to .env and change every secret before any real use.
# ============================================================================

# ---- App ----
APP_ENV=dev                       # dev | prod
APP_NAME=Egreen Quanta
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                    # true in prod

# ---- Database ----
# dev (default): local SQLite, no server needed
DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# prod example:
# DATABASE_URL=postgresql+asyncpg://egreen:CHANGE_ME@db:5432/egreen

# ---- Security / auth ----
SECRET_KEY=dev-only-insecure-change-me-32bytes-minimum
JWT_ALGORITHM=HS256              # HS256 | RS256 (RS256 needs the *_KEY_PATH vars)
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_TTL=900             # seconds (15 min)
REFRESH_TOKEN_TTL=1209600        # seconds (14 days)
PASSWORD_ARGON2_TIME_COST=3
PASSWORD_ARGON2_MEMORY_COST=65536
TOTP_ISSUER=EgreenQuanta
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Audit log ----
AUDIT_SIGNING_KEY=               # base64 Ed25519 seed; blank = anchor signing disabled
AUDIT_ANCHOR_CRON=0 2 * * *      # daily 02:00

# ---- Artifact storage ----
STORE_ARTIFACTS=false
ARTIFACT_ENC_KEY=                # base64 32-byte AES-GCM key; required if STORE_ARTIFACTS=true
MAX_UPLOAD_MB=25

# ---- Revocation / outbound ----
OUTBOUND_REVOCATION=false        # true to allow CRL/OCSP/TSA fetches
REVOCATION_TIMEOUT_SECONDS=5
REVOCATION_MAX_RESPONSE_KB=1024
TRUSTED_TSA_URLS=

# ---- Quantum-inspired defaults ----
QUANTUM_DEFAULT_SWEEPS=2000
QUANTUM_DEFAULT_RESTARTS=8
QUANTUM_TROTTER_SLICES=20
QUANTUM_SEED=1337
QC_YEAR_ASSUMPTION=2035          # assumed arrival of a cryptographically-relevant quantum computer

# ---- ML (optional, local) ----
ML_ENABLED=false
ML_MODEL_DIR=./var/models
ML_ANOMALY_WEIGHT=0.2            # blend weight into risk score when enabled

# ---- Background jobs ----
REDIS_URL=                       # blank = APScheduler in-process (dev)
# REDIS_URL=redis://redis:6379/0

# ---- Notifications (optional, off by default) ----
NOTIFY_HIGH_SEVERITY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=egreen-quanta@localhost
SLACK_WEBHOOK=

# ---- Frontend (Vite; also set in frontend/.env) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
